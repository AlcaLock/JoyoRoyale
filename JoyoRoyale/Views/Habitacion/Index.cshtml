@model List<Crucero.Application.DTOs.HabitacionesDTO>

@{
    ViewData["Title"] = "Habitaciones";
}

<h1>Habitaciones Disponibles</h1>

<p>
    
</p>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var habitacion in Model)
    {
        <div class="col">
            <div class="card shadow-sm">
                <img class="card-img-top"
                     style="max-height: 460px;"
                     role="img"
                     src="data:image/jpeg;charset=utf-8;base64,@Convert.ToBase64String(habitacion.Imagen)"
                     alt="Imagen de la habitación" />

                <div class="card-body">
                    <h5 class="card-title">@habitacion.Nombre</h5>
                    <p class="card-text">@habitacion.Descripcion</p>

                    <p class="card-text">
                        <strong>Capacidad:</strong>
                        @habitacion.CapacidadMinima - @habitacion.CapacidadMaxima huéspedes
                    </p>

                    <p class="card-text">
                        <strong>Tamaño:</strong> @habitacion.Tamano m²
                    </p>
                </div>

                <div class="card-body">
                    <a class="btn btn-primary" asp-action="Details" asp-route-id="@habitacion.Id">
                        <i class="bi bi-eye"></i> Ver Detalles
                    </a>
                   
                </div>
            </div>
        </div>
    }
</div>

