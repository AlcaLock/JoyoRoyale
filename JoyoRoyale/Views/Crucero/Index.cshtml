@model List<Crucero.Application.DTOs.CrucerosDTO>

@{
    ViewData["Title"] = "Crucero";
}


@foreach (var crucero in Model)
{
    <div class="col">
        <div class="card shadow-sm">
            <div class="row g-0">
                <div class="col-md-4">
                    <img class="img-fluid rounded-start"
                         style="max-height:400px; width: 250px;"
                         role="img"
                         src="data:image/jpeg;charset=utf-8;base64,@Convert.ToBase64String(crucero.Imagen)"
                         alt="Imagen" />
                </div>
                <div class="col-md-8">
                    <div class="card-body">
                        <h5 class="card-title">@crucero.Nombre</h5>
                        <p class="card-text"><strong>Días:</strong> @crucero.Dias</p>
                        <p class="card-text"><strong>Descripcion:</strong> @crucero.Descripcion</p>
                        <p class="card-text">
                            <strong>Barco:</strong> @(crucero.Barco != null ? crucero.Barco.Nombre : "Sin barco asignado")
                        </p>

                    </div>
                    <div class="card-body">
                        <a class="btn btn-primary" asp-action="Details" asp-route-id="@crucero.Id">Detalles</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
