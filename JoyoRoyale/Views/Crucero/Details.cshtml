@model Crucero.Application.DTOs.CrucerosDTO

@{
    ViewData["Title"] = "Detalles del Crucero";
}

<h1>Detalles del Crucero</h1>

<div class="card">
    <div class="card-header">
        <h2>@Model.Nombre</h2>
    </div>
    <div class="card-body">
        <!-- Imagen del crucero -->
        <div class="mb-3">
            <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Imagen)"
                 alt="Imagen del crucero"
                 class="img-fluid rounded"
                 style="max-width: 400px; height: auto;" />
        </div>

        <dl class="row">
            <dt class="col-sm-3">Duración:</dt>
            <dd class="col-sm-9">@Model.Dias días</dd>

            <dt class="col-sm-3">Barco:</dt>
            <dd class="col-sm-9">@Model.Barco.Nombre</dd>
        </dl>

        <!-- Itinerario -->
        <h4>Itinerario</h4>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Día</th>
                    <th>Puerto</th>
                    <th>Descripción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Itinerarios != null && Model.Itinerarios.Any())
                {
                    @foreach (var item in Model.Itinerarios.OrderBy(i => i.Dia))
                    {
                        <tr>
                            <td>Día @item.Dia</td>
                            <td>@item.Puerto.Nombre</td>
                            <td>@item.Descripcion</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3">No hay itinerario disponible</td></tr>
                }
            </tbody>
        </table>

        <!-- Fechas y precios -->
        <h4>Fechas y Precios</h4>
        @if (Model.FechasCruceros != null && Model.FechasCruceros.Any())
        {
            @foreach (var fecha in Model.FechasCruceros)
            {
                <div class="mb-4">
                    <h5>Fecha de salida: @fecha.FechaInicio.ToString("dd/MM/yyyy")</h5>
                    @* <h5>Fecha de salida: @fecha.Fecha.ToString("dd/MM/yyyy")</h5> *@
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Tipo de habitación</th>
                                <th>Precio</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (fecha.PreciosHabitaciones != null && fecha.PreciosHabitaciones.Any())
                            {
                                // Materializar la colección antes de usar GroupBy y Select
                                var preciosEnMemoria = fecha.PreciosHabitaciones.ToList();

                                // Agrupar precios por habitación
                                var preciosAgrupados = preciosEnMemoria
                                .GroupBy(p => p.Habitacion.Id)
                                .Select(g => new
                                {
                                    Habitacion = g.First().Habitacion,
                                    Precios = g.Select(p => p.Precio).ToList()
                                });

                                @foreach (var grupo in preciosAgrupados)
                                {
                                    <tr>
                                        <td>@grupo.Habitacion.Nombre</td>
                                        <td>
                                            @foreach (var precio in grupo.Precios)
                                            {
                                                <div>@precio.ToString("C")</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="2">No hay precios disponibles para esta fecha</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">No hay fechas programadas</div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>