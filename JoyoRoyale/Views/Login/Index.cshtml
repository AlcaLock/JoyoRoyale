@model Crucero.Web.ViewModels.ViewModelLogin
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar Sesión - JoyoRoyale</title>

    <!-- Bootstrap y estilos -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.4/dist/sweetalert2.min.css" />

    <style>
        body, html {
            height: 100%;
            margin: 0;
            overflow: hidden;
            font-family: 'Segoe UI', sans-serif;
        }

        .video-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
        }

        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.55);
            z-index: -1;
        }

        .login-card {
            background-color: rgba(255, 255, 255, 0.92);
            border-radius: 1.5rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
            padding: 2.5rem;
            max-width: 430px;
            width: 100%;
        }

        .login-container {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .form-control {
            border-radius: 1rem;
        }

        .btn-login {
            border-radius: 2rem;
        }

        .btn-register {
            margin-top: 1rem;
            font-size: 0.9rem;
        }

        #loader.loading {
            margin: 0 auto;
            border: 4px solid #f3f3f3;
            border-top: 4px solid #0d6efd;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            animation: spin 0.7s linear infinite;
        }

        
    </style>
</head>

<body>
    <!-- Video de fondo -->
    <video class="video-bg" autoplay muted loop playsinline>
        <source src="~/imagenes/VideoLogin.mp4" type="video/mp4">
        Tu navegador no soporta videos HTML5.
    </video>
    <div class="overlay"></div>

    <!-- Login Card -->
    <div class="container login-container">
        <div class="login-card">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock-fill fs-1 text-primary"></i>
                <h3 class="fw-bold">Iniciar Sesión</h3>
            </div>

            <form asp-controller="Login" asp-action="LogIn" method="post" asp-antiforgery="true">
                <div class="mb-3">
                    <label asp-for="User" class="form-label">Usuario</label>
                    <input asp-for="User" class="form-control" />
                    <span asp-validation-for="User" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" class="form-control" type="password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-grid mb-2">
                    <button type="submit" class="btn btn-primary btn-login" onclick="spinnerEffect()">
                        <i class="bi bi-box-arrow-in-right"></i> Ingresar
                    </button>
                </div>

                <div id="loader" style="height: 2rem;"></div>

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-danger mt-3 text-center">
                        @ViewBag.Message
                    </div>
                }

                <div class="text-center mt-3">
                    <a class="btn btn-link btn-register text-dark" href="@Url.Action("Registro", "Usuarios")">
                        <i class="bi bi-person-plus-fill"></i> ¿No tienes cuenta? Regístrate
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-ajax-unobtrusive/3.2.6/jquery.unobtrusive-ajax.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.4/dist/sweetalert2.all.min.js"></script>

    <script>
        function spinnerEffect() {
            document.getElementById("loader").className = "loading";
        }
    </script>

    @if (ViewBag.NotificationMessage != null)
    {
        <script>
            @Html.Raw(@ViewBag.NotificationMessage);
        </script>
    }
</body>
</html>
