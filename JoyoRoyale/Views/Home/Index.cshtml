@{
    ViewData["Title"] = "Inicio";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f0f8ff;
            font-family: 'Arial', sans-serif;
        }

        .img-ajustada {
            object-fit: cover;
            width: 100%;
            height: 400px;
            display: block;
        }


        .carousel-item img {
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .carousel-caption {
            background: rgba(0, 0, 0, 0.5);
            border-radius: 10px;
            padding: 20px;
        }

            .carousel-caption h5 {
                color: #ff7f50; /* Coral */
                font-size: 2rem;
            }

            .carousel-caption p {
                color: #ffffff;
                font-size: 1.2rem;
            }

        .section-title {
            color: #0077be;
            margin-top: 2rem;
            margin-bottom: 1rem;
        }

        .card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s;
        }

            .card:hover {
                transform: scale(1.05);
            }

        .card-img-top {
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        .card-title {
            color: #0077be;
        }

        .card-text {
            color: #333333;
        }

        .btn-primary {
            background-color: #ff7f50;
            border: none;
            border-radius: 5px;
            padding: 10px 20px;
        }

            .btn-primary:hover {
                background-color: #ff6347;
            }
    </style>
</head>
<body>
    <!-- Carrusel -->
    <div id="exampleCarrusel" class="carousel slide" style="padding-top:1em">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#exampleCarrusel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#exampleCarrusel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#exampleCarrusel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="./imagenes/CruceroAventuraTropical.jpg" class="d-block w-100 img-ajustada" alt="Eventos" height="300">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Explora el Caribe</h5>
                    <p>Disfruta de las playas más exóticas y aguas cristalinas.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="./imagenes/CruceroMaravillasMediterraneo.jpg" class="d-block w-100 img-ajustada" alt="Eventos" height="300">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Aventura en el Mediterráneo</h5>
                    <p>Descubre la historia y la cultura del Mediterráneo.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="./imagenes/CruceroExploraciónPacifico.jpg" class="d-block w-100 img-ajustada" alt="Eventos" height="300">
                <div class="carousel-caption d-none d-md-block">
                    <h5>Lujo en el Pacifico</h5>
                    <p>Vive la experiencia única de las hermosas aguas del pacifico.</p>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#exampleCarrusel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#exampleCarrusel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    @* <!-- Destinos Populares -->
    <div class="container mt-5">
        <h2 class="section-title">Destinos Populares</h2>
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <img src="./images/destino1.jpg" class="card-img-top" alt="Destino 1">
                    <div class="card-body">
                        <h5 class="card-title">Caribe</h5>
                        <p class="card-text">Disfruta de las playas más exóticas y aguas cristalinas.</p>
                        <a href="#" class="btn btn-primary">Más información</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <img src="./images/destino2.jpg" class="card-img-top" alt="Destino 2">
                    <div class="card-body">
                        <h5 class="card-title">Mediterráneo</h5>
                        <p class="card-text">Descubre la historia y la cultura del Mediterráneo.</p>
                        <a href="#" class="btn btn-primary">Más información</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <img src="./images/destino3.jpg" class="card-img-top" alt="Destino 3">
                    <div class="card-body">
                        <h5 class="card-title">Alasca</h5>
                        <p class="card-text">Vive la experiencia única de los fiordos y glaciares.</p>
                        <a href="#" class="btn btn-primary">Más información</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ofertas Especiales -->
    <div class="container mt-5">
        <h2 class="section-title">Ofertas Especiales</h2>
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <img src="./images/oferta1.jpg" class="card-img-top" alt="Oferta 1">
                    <div class="card-body">
                        <h5 class="card-title">Oferta Caribe</h5>
                        <p class="card-text">Aprovecha nuestras ofertas especiales para el Caribe.</p>
                        <a href="#" class="btn btn-primary">Ver oferta</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <img src="./images/oferta2.jpg" class="card-img-top" alt="Oferta 2">
                    <div class="card-body">
                        <h5 class="card-title">Oferta Mediterráneo</h5>
                        <p class="card-text">Descubre nuestras promociones para el Mediterráneo.</p>
                        <a href="#" class="btn btn-primary">Ver oferta</a>
                    </div>
                </div>
            </div>
        </div>
    </div> *@

    <!-- Testimonios -->
    <div class="container mt-5 mb-5">
        <h2 class="section-title">Testimonios</h2>
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">María González</h5>
                        <p class="card-text">"El viaje fue increíble, todo estuvo perfectamente organizado. ¡Volveré a viajar con ustedes!"</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Juan Pérez</h5>
                        <p class="card-text">"Una experiencia única, el personal fue muy amable y los destinos espectaculares."</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Laura Martínez</h5>
                        <p class="card-text">"Recomiendo totalmente estos cruceros, todo fue de primera calidad."</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript">
        const myCarouselElement = document.getElementById('exampleCarrusel')

        const carousel = new bootstrap.Carousel(myCarouselElement, {
          interval: 3000,
        })
    </script>
</body>
</html>