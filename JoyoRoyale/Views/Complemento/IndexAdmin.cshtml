@model List<Crucero.Application.DTOs.ComplementosDTO>

@{
    ViewData["Title"] = "Administrar Complementos";
}

<h1>Administrar Complementos</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Agregar Nuevo Complemento</a>
</p>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model[0].Id)</th>
            <th>@Html.DisplayNameFor(model => model[0].Nombre)</th>
            <th>@Html.DisplayNameFor(model => model[0].Descripcion)</th>
            <th>@Html.DisplayNameFor(model => model[0].Precio)</th>
            <th>@Html.DisplayNameFor(model => model[0].TipoAplicacion)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nombre</td>
                <td>@item.Descripcion</td>
                <td>@item.Precio.ToString("C")</td>
                <td>@item.TipoAplicacion</td>
                <td>
                    <a asp-action="UpdateCo" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>

                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Verificar si hay un mensaje en TempData
        var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
        if (mensaje) {
            Swal.fire({
                icon: 'success',
                title: 'Éxito',
                text: mensaje,
                confirmButtonText: 'Aceptar'
            });
        }
    </script>
}