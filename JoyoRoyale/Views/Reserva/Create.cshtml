                        day: '2-digit',
                        month: 'long',
                        year: 'numeric'
                    }));
                    $('#info-fecha-limite').show();

                    // Calcular fecha límite para pago restante (15 días antes del viaje)
                    const fechaLimiteRestante = new Date(fechaLimite);
                    fechaLimiteRestante.setDate(fechaLimite.getDate() - 15);
                    $('#fecha-limite-pago').text(fechaLimiteRestante.toLocaleDateString('es-ES', {
                        day: '2-digit',
                        month: 'long',
                        year: 'numeric'
                    }));
                }
            } catch (error) {
                console.error("Error al obtener fecha límite:", error);
            }

            // 2. Configurar información del usuario
        try {
            const data = await $.get('/Reserva/GetObtenerDatosUsuario');
            $('#usuario-nombre').text(data.nombre);
            $('#usuario-email').text(data.email);
        } catch (error) {
            console.error("No se pudo obtener los datos del usuario:", error);
            $('#usuario-nombre').text("Desconocido");
            $('#usuario-email').text("sin-correo@demo.com");
        }


            // 3. Calcular y mostrar montos
            const total = calcularTotal();
            $('#monto-total').text('₡' + total.toFixed(2));
            $('#monto-deposito').text('₡' + (total * 0.5).toFixed(2));
            $('#monto-restante').text('₡' + (total * 0.5).toFixed(2));

            // 4. Mostrar paso de pago
            $('#step6-container').hide();
            $('#step7-container').show();
            currentStep = 7;
        });


        // Función para procesar el pago y crear la reserva
        function procesarPagoYCrearReserva(esDeposito) {
            // 1. Crear el objeto básico de reserva
            const total = calcularTotal();
            const montoAPagar = esDeposito ? total * 0.5 : total;

            const reservaDTO = {
                CruceroId: cruceroSeleccionado.id,
                Total: montoAPagar, 
                UsuarioId: usuarioId,
                Huespedes: [],
                ReservasHabitaciones: [],
                ReservasComplementos: []
            };

            // 2. Agregar huéspedes (igual que antes)
            $('#huespedes-container > div').each(function() {
                const inputs = $(this).find('input, select');
                reservaDTO.Huespedes.push({
                    Nombre: $(inputs[0]).val(),
                    Apellidos: $(inputs[1]).val(),
                    Edad: parseInt($(inputs[2]).val()),
                    DocumentoIdentidad: $(inputs[3]).val(),
                    Telefono: $(inputs[4]).val()
                });
            });

            // 3. Agregar habitaciones (igual que antes)
            habitacionesSeleccionadas.forEach(hab => {
                for (let i = 0; i < hab.cantidad; i++) {
                    reservaDTO.ReservasHabitaciones.push({
                        HabitacionId: hab.id,
                        CantidadPasajeros: hab.pasajerosPorHab,
                        Total: hab.precio
                    });
                }
            });

            // 4. Agregar complementos (igual que antes)
            complementosSeleccionados.forEach(comp => {
                reservaDTO.ReservasComplementos.push({
                    ComplementoId: comp.id,
                    Cantidad: comp.cantidad,
                    Total: comp.precio * comp.cantidad
                });
            });

            // 5. Enviar al backend (igual que antes)
            $.ajax({
                url: '/Reserva/Create',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(reservaDTO),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        window.location.href = '/Reserva/Details/' + response.reservaId;
                    } else {
                        let errorMsg = 'Error: ';
                        if (response.message) {
                            errorMsg += response.message;
                        } else if (response.errors) {
                            errorMsg += Object.values(response.errors).join('\n');
                        } else {
                            errorMsg += 'Error desconocido al crear la reserva';
                        }
                        alert(errorMsg);
                    }
                },
                error: function(xhr) {
                    let errorMsg = 'Error en la solicitud (HTTP ' + xhr.status + ')\n';
                    try {
                        const response = JSON.parse(xhr.responseText);
                        if (response.message) {
                            errorMsg += 'Mensaje: ' + response.message + '\n';
                        }
                        if (response.errors) {
                            errorMsg += 'Errores:\n';
                            for (var key in response.errors) {
                                if (response.errors.hasOwnProperty(key)) {
                                    errorMsg += '- ' + key + ': ' + response.errors[key].join(', ') + '\n';
                                }
                            }
                        }
                    } catch (e) {
                        errorMsg += 'Respuesta del servidor: ' + xhr.responseText;
                    }
                    alert(errorMsg);
                }
            });
        }

                $(document).ready(function () {
            // Formatear el número de tarjeta automáticamente
            $('#tarjetaNumero').on('input', function () {
                let valor = $(this).val().replace(/\D/g, ''); // Solo números
                valor = valor.substring(0, 16); // Máximo 16 dígitos
                let formateado = valor.match(/.{1,4}/g)?.join(' ') || '';
                $(this).val(formateado);
            });

            // Formatear la fecha de expiración automáticamente
            $('#tarjetaExpiracion').on('input', function () {
                let valor = $(this).val().replace(/\D/g, '');
                if (valor.length > 2) {
                    valor = valor.substring(0, 4);
                    valor = valor.replace(/(\d{2})(\d{1,2})/, '$1/$2');
                }
                $(this).val(valor);
            });
        });



        // Evento para el botón de procesar pago
               // Evento para el botón de procesar pago
        $(document).on('click', '#btnProcesarPago', function () {
            // Validar datos de tarjeta (simulación)
            const tarjetaNumero = $('#tarjetaNumero').val().replace(/\s+/g, ''); // Eliminar espacios
            const fechaExp = $('#tarjetaExpiracion').val();
            const [mesStr, añoStr] = fechaExp.split('/');
            const mes = parseInt(mesStr, 10);
            const año = parseInt('20' + añoStr, 10); // Asume formato 'MM/AA' (ej: 04/25 → 2025)

            // Fecha actual
            const hoy = new Date();
            const mesActual = hoy.getMonth() + 1; // JS cuenta desde 0
            const añoActual = hoy.getFullYear();

            const tarjetaVigente = (año > añoActual) || (año === añoActual && mes >= mesActual);

            const tarjetaValida = tarjetaNumero.length === 16 &&
                                  fechaExp.length === 5 &&
                                  $('#tarjetaCVV').val().length === 3 &&
                                  $('#tarjetaTitular').val().trim().length > 0 &&
                                  tarjetaVigente;

            // Validar si todos los datos son correctos
            if (!tarjetaValida) {
                if (!tarjetaVigente) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Tarjeta vencida',
                        text: 'La fecha de expiración indica que la tarjeta ya no está vigente. Por favor revise los datos.',
                        confirmButtonText: 'Ok'
                    });
                } else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Datos incompletos',
                        text: 'Por favor complete correctamente todos los datos de la tarjeta',
                        confirmButtonText: 'Entendido'
                    });
                }
                return;
            }

            // Determinar si es depósito o pago completo
            const esDeposito = $('input[name="opcionPago"]:checked').val() === 'deposito';
            const monto = esDeposito ? calcularTotal() * 0.5 : calcularTotal();

            Swal.fire({
                title: '¿Confirmar pago?',
                text: `¿Deseas confirmar el pago por ₡${monto.toFixed(2)}?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, pagar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33'
            }).then((result) => {
                if (result.isConfirmed) {
                    procesarPagoYCrearReserva(esDeposito);
                }
            });
        });


    </script>
