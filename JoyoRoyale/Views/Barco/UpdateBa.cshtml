@model Crucero.Application.DTOs.BarcosDTO

@{
    ViewData["Title"] = "Editar Barco";
}

<h1>Editar Barco</h1>

<h4>Detalles del Barco</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- ID (solo lectura) -->
            <div class="form-group">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" class="form-control" readonly />
            </div>

            <!-- Nombre -->
            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <!-- Descripción -->
            <div class="form-group">
                <label asp-for="Descripcion" class="control-label"></label>
                <textarea asp-for="Descripcion" class="form-control"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <!-- Capacidad -->
            <div class="form-group">
                <label asp-for="Capacidad" class="control-label"></label>
                <input asp-for="Capacidad" type="number" class="form-control" />
                <span asp-validation-for="Capacidad" class="text-danger"></span>
            </div>

            <!-- Imagen actual -->
            <div class="form-group">
                <label>Imagen actual:</label>
                <div id="imagenActualContainer">
                    @if (Model.Imagen != null && Model.Imagen.Length > 0)
                    {
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Imagen)" class="img-thumbnail" id="imagenActual" width="150" />
                    }
                    else
                    {
                        <p>No hay imagen disponible.</p>
                    }
                </div>
            </div>

            <!-- Campo para subir nueva imagen -->
            <div class="form-group">
                <label>Subir nueva imagen:</label>
                <input type="file" class="form-control" name="nuevaImagen" id="imageFile" />
                <div class="mt-2">
                    <img id="imagePreview" class="img-thumbnail d-none" width="150" />
                </div>
            </div>

            <br />

            <!-- Habitaciones Disponibles -->
            <h4 class="mt-4">Habitaciones Disponibles</h4>
            <p>Selecciona los tipos de habitaciones y su cantidad.</p>

            <div class="form-group">
                <div class="row">
                    @foreach (var habitacion in ViewBag.Habitaciones)
                    {
                        var habitacionSeleccionada = Model.BarcoHabitaciones?.FirstOrDefault(h => h.HabitacionId == habitacion.Id);
                        bool isChecked = habitacionSeleccionada != null;
                        int cantidad = isChecked ? habitacionSeleccionada.CantidadDisponible : 0;

                        <div class="col-md-6">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input habitacion-checkbox"
                                       id="hab_@habitacion.Id" name="HabitacionIds"
                                       value="@habitacion.Id" @(isChecked ? "checked" : "") />
                                <label class="form-check-label" for="hab_@habitacion.Id">@habitacion.Nombre</label>
                            </div>
                            <input type="number" name="Cantidades"
                                   class="form-control cantidad-input mt-1"
                                   placeholder="Cantidad disponible"
                                   min="1" value="@cantidad" @(isChecked ? "" : "disabled") />
                        </div>
                    }
                </div>
            </div>

            <br />

            <!-- Botón de guardar -->
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                <a asp-action="IndexAdmin" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Funcionalidad para la vista previa de la nueva imagen
            document.getElementById('imageFile').addEventListener('change', function (event) {
                const file = event.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const preview = document.getElementById('imagePreview');
                        preview.src = e.target.result;
                        preview.classList.remove('d-none');

                        // Ocultar imagen actual si hay una nueva imagen cargada
                        const imagenActual = document.getElementById('imagenActual');
                        if (imagenActual) {
                            imagenActual.style.display = "none";
                        }
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Habilitar o deshabilitar input de cantidad según checkbox
            let checkboxes = document.querySelectorAll(".habitacion-checkbox");
            let cantidadInputs = document.querySelectorAll(".cantidad-input");

            checkboxes.forEach((checkbox, index) => {
                checkbox.addEventListener("change", function () {
                    cantidadInputs[index].disabled = !checkbox.checked;
                    if (!checkbox.checked) cantidadInputs[index].value = "";
                });
            });
        });


             var errores = @Html.Raw(Json.Serialize(TempData["ErrorMessages"]));
        if (errores) {
            Swal.fire({
                icon: 'error',
                title: 'Errores encontrados',
                html: errores.replace(/\|/g, '<br>'),
            });
        }

        var mensaje = @Html.Raw(Json.Serialize(TempData["Mensaje"]));
        if (mensaje) {
            Swal.fire({
                icon: 'success',
                title: 'Éxito',
                text: mensaje
            });
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
